# Copy this file to .env (or .env.local) and fill in real values.
# All variables are NEXT_PUBLIC_ because they're rendered directly on the
# public page (contact info, links, image URLs) — this keeps personal
# details out of source control, it does not make them secret.

# Production URL of the deployed site (used for canonical/OG tags, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact details shown in the Hero/Contact/Footer sections and floating actions
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CONTACT_PHONE=+00 00 000 0000
NEXT_PUBLIC_CONTACT_LOCATION=City, Country

# Social / external links
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-handle
NEXT_PUBLIC_CV_URL=https://drive.google.com/uc?export=download&id=your-file-id

# Cloudinary account that serves the avatar, education background, and
# experience screenshots (src/lib/cloudinary.ts)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
